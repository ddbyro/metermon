[Unit]
Description=RTL-SDR TCP server (local only, feeds rtlamr)
After=network.target
StartLimitIntervalSec=0

[Service]
User=ddbyro
Group=plugdev
# rtl_tcp logs "ll+, now N" for every buffer; at ~10k lines/hour that floods
# a volatile journal, so filter it out and keep everything else.
ExecStart=/bin/sh -c 'exec /usr/bin/rtl_tcp -a 127.0.0.1 -p 1234 2>&1 | grep --line-buffered -vE "^ll[+-], now"'
Restart=always
RestartSec=10

[Install]
WantedBy=multi-user.target
