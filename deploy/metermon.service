[Unit]
Description=metermon: rtlamr meter readings to MQTT
After=network-online.target rtl_tcp.service
Wants=network-online.target rtl_tcp.service
# never give up restarting
StartLimitIntervalSec=0

[Service]
Type=simple
User=ddbyro
Group=ddbyro
WorkingDirectory=/opt/metermon
Environment=SETTINGS_MODULE=settings
Environment=PYTHONUNBUFFERED=1
ExecStart=/usr/local/bin/python3.13 /opt/metermon/metermon.py
SyslogIdentifier=metermon
Restart=always
RestartSec=10

# light hardening: metermon only needs the network and to run rtlamr
NoNewPrivileges=true
PrivateTmp=true
ProtectHome=true
ProtectSystem=full
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectControlGroups=true

[Install]
WantedBy=multi-user.target
